{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "StaffPlus — Functional API Tests",
    "description": "Functional API tests verifying correct data is returned from every major module.\nTests JSON structure, HTTP status codes, pagination, filtering, and data relationships.\n\nPrerequisite: set the `cookie` variable to a valid bmgmt_sess session cookie.\nRun: newman run staffplus_functional_api.json --env-var 'cookie=<your_session>'",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://robomon.boundaryless.com/test/timetracker"
    },
    {
      "key": "cookie",
      "value": "bmgmt_sess=REPLACE_WITH_YOUR_SESSION_COOKIE",
      "description": "Replace with actual session value from .auth/session.json cookies array"
    }
  ],
  "item": [

    {
      "name": "01 — Dashboard",
      "item": [
        {
          "name": "GET /dashboard — loads with 200",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/public/dashboard",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Not login redirect — session is active', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "  const body = pm.response.text();",
              "  pm.expect(body).to.include('dashboard');",
              "});",
              "pm.test('No server error', () => {",
              "  const body = pm.response.text();",
              "  pm.expect(body).to.not.include('Whoops');",
              "  pm.expect(body).to.not.include('Stack trace');",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /dashboard — response time < 5s",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/public/dashboard",
            "header": [{ "key": "Cookie", "value": "{{cookie}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Response time under 5000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ]}
          }]
        }
      ]
    },

